{
  "manifest_version": 3,
  "name": "YouTube Playlist Manager",
  "version": "0.2.0",
  "description": "Organize your YouTube playlists into folders, sync your changes back to YouTube, and back everything up as one JSON file.",
  "key": "",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open your YouTube playlists",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "identity"
  ],
  "host_permissions": [
    "https://www.googleapis.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "lib/model.js",
        "lib/storage.js",
        "lib/sync.js",
        "content/dom.js",
        "content/styles.js",
        "content/dnd.js",
        "content/sync.js",
        "content/dashboard.js",
        "content/main.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
